<Window x:Class="ReimbursementAssistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReimBox 设置" Icon="pack://application:,,,/ReimBox;component/logo/icon.png" Width="650" Height="650" MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F6F8FC" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="ShortcutKeyStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Border Margin="22" Padding="26" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="规则与偏好设置" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="修改后会立即重新检查当前项目，设置保存在本机。" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#F8FAFC" CornerRadius="14" Padding="17" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="耗材规则" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                            <TextBlock Text="超过该金额时要求支付凭证" Foreground="#64748B" Margin="0,0,0,6"/>
                            <TextBox x:Name="ThresholdBox"/>
                            <CheckBox x:Name="ThreeDDetailsCheck" Content="3D 打印发票要求上传打印明细" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="14" Padding="17" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="差旅规则" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                            <CheckBox x:Name="FlightOrderCheck" Content="飞机票要求订单页面"/>
                            <CheckBox x:Name="FlightPaymentCheck" Content="飞机票要求支付记录截图"/>
                            <CheckBox x:Name="TrainOrderCheck" Content="火车票要求订单页面"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="14" Padding="17">
                        <StackPanel>
                            <TextBlock Text="软件行为" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                            <CheckBox x:Name="IncompleteExportCheck" Content="允许仍有缺失材料时继续导出"/>
                            <CheckBox x:Name="UpdateCheck" Content="启动时静默检查 GitHub 新版本"/>
                            <CheckBox x:Name="PaddleAutoCheck" Content="PDF 文本不足时自动尝试 Paddle 深度识别（可能较慢）"/>
                            <TextBlock x:Name="LearningCountText" Foreground="#64748B" Margin="0,8,0,8"/>
                            <Button Content="清除本地分类学习记录" Click="ClearLearning_Click" HorizontalAlignment="Left" Background="White" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="14" Padding="17" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="快捷键" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource ShortcutKeyStyle}"><TextBlock Text="Ctrl" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource ShortcutKeyStyle}"><TextBlock Text="O" FontWeight="SemiBold"/></Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="导入 PDF 发票文件" Foreground="#334155" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource ShortcutKeyStyle}"><TextBlock Text="Ctrl" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource ShortcutKeyStyle}"><TextBlock Text="S" FontWeight="SemiBold"/></Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="保存当前 ReimBox 项目" Foreground="#334155" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource ShortcutKeyStyle}"><TextBlock Text="Ctrl" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource ShortcutKeyStyle}"><TextBlock Text="F" FontWeight="SemiBold"/></Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="搜索发票、项目、商户或金额" Foreground="#334155" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource ShortcutKeyStyle}"><TextBlock Text="Esc" FontWeight="SemiBold"/></Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="清空搜索内容" Foreground="#334155" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="2" Margin="0,20,0,0">
                <Button Content="恢复默认规则" Click="RestoreDefaults_Click" HorizontalAlignment="Left" Background="White" BorderBrush="#CBD5E1"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" Click="Cancel_Click" Margin="10,0"/><Button Content="保存设置" Click="Save_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/></StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
