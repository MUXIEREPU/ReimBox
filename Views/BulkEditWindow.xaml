<Window x:Class="ReimbursementAssistant.Views.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量编辑" Icon="pack://application:,,,/ReimBox;component/logo/icon.png"
        Width="620" Height="650" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="#F6F8FC" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="10,0"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Border Margin="22" Padding="26" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <Border Background="#EFF6FF" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left"><TextBlock x:Name="CountText" Foreground="#1D4ED8" FontWeight="SemiBold"/></Border>
                <TextBlock Text="批量编辑发票" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,5"/>
                <TextBlock Text="只勾选需要修改的项目。未勾选的字段会保持原样。" Foreground="#64748B"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                <StackPanel>
                    <Border Padding="16" Background="#F8FAFC" CornerRadius="14" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="CategoryCheck" Content="统一修改一级分类"/>
                            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                            <CheckBox x:Name="SubCategoryCheck" Content="统一修改差旅二级分类" Margin="0,16,0,12"/>
                            <ComboBox x:Name="SubCategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="16" Background="#F8FAFC" CornerRadius="14" Margin="0,0,0,12">
                        <StackPanel>
                            <CheckBox x:Name="AttachmentTypeCheck" Content="统一修改已添加附件的类型"/>
                            <ComboBox x:Name="AttachmentTypeBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="16" Background="#F8FAFC" CornerRadius="14">
                        <StackPanel>
                            <CheckBox x:Name="IgnoreCheck" Content="标记为忽略"/>
                            <CheckBox x:Name="RestoreCheck" Content="恢复已忽略项目"/>
                            <CheckBox x:Name="ReanalyzeCheck" Content="应用后重新识别这些发票"/>
                            <CheckBox x:Name="RemoveCheck" Content="从当前列表移除（不删除原始文件）" Foreground="#B91C1C"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="批量修改可以撤回删除，但分类修改会直接应用到当前项目。" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="330"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Click="Cancel_Click" Margin="10,0" Background="White" BorderBrush="#CBD5E1"/>
                    <Button Content="应用修改" Click="Apply_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderBrush="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
