<Window x:Class="ReimbursementAssistant.Views.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量编辑"
        Icon="pack://application:,,,/ReimBox;component/logo/icon.png"
        Width="680"
        Height="700"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5EAF2" />

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Grid>
                                                <ContentPresenter Margin="12,0,36,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                                <Path HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,14,0"
                                                      Fill="#64748B"
                                                      Data="M 0 0 L 8 0 L 4 5 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD" />
                                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" />
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border Margin="24"
            Padding="28"
            Background="White"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="批量编辑发票" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="只勾选需要修改的项目，未勾选字段会保持原样。" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13,7"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="CountText" Foreground="#1D4ED8" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
                <StackPanel>
                    <Border Padding="18" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="分类信息" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="适合一次性把多张发票归到同一个费用项。" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" />
                            <CheckBox x:Name="CategoryCheck" Content="统一修改一级分类" />
                            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value" />
                            <CheckBox x:Name="SubCategoryCheck" Content="统一修改差旅二级分类" Margin="0,16,0,12" />
                            <ComboBox x:Name="SubCategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value" />
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="附件类型" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="只会影响已添加附件的材料类型，不会修改原始发票。" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" />
                            <CheckBox x:Name="AttachmentTypeCheck" Content="统一修改已添加附件的类型" />
                            <ComboBox x:Name="AttachmentTypeBox" DisplayMemberPath="Label" SelectedValuePath="Value" />
                        </StackPanel>
                    </Border>

                    <Border Padding="18" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="16">
                        <StackPanel>
                            <TextBlock Text="批量操作" FontWeight="SemiBold" FontSize="16" Foreground="#9A3412" Margin="0,0,0,4" />
                            <TextBlock Text="移除只是从当前列表删除记录，原始 PDF 不会被删除。" Foreground="#9A3412" Margin="0,0,0,14" />
                            <CheckBox x:Name="IgnoreCheck" Content="标记为忽略" />
                            <CheckBox x:Name="RestoreCheck" Content="恢复已忽略项目" />
                            <CheckBox x:Name="ReanalyzeCheck" Content="应用后重新识别这些发票" />
                            <CheckBox x:Name="RemoveCheck" Content="从当前列表移除（不删除原始文件）" Foreground="#B91C1C" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,22,0,0">
                <TextBlock Text="应用前请确认选择范围，分类修改会直接应用到当前项目。"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxWidth="360" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消"
                            Click="Cancel_Click"
                            Style="{StaticResource RoundedButtonStyle}"
                            Margin="10,0" />
                    <Button Content="应用修改"
                            Click="Apply_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
