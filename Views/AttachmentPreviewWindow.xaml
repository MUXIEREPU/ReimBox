<Window x:Class="ReimbursementAssistant.Views.AttachmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="附件预览" Icon="pack://application:,,,/ReimBox;component/logo/icon.png" Width="850" Height="680" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F6F8FC" FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="FileNameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="StatusText" Foreground="#64748B" Margin="0,6,0,14" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="14">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="Uniform"/></ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="正在准备预览…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" FontSize="17" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="关闭" Click="Close_Click" Padding="18,10" Margin="0,0,10,0"/><Button Content="使用默认程序打开" Click="Open_Click" Padding="18,10" Background="#2563EB" Foreground="White"/></StackPanel>
    </Grid>
</Window>
