<Window x:Class="ReimbursementAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReimbursementAssistant.ViewModels"
        xmlns:converters="clr-namespace:ReimbursementAssistant.Converters"
        Title="ReimBox"
        Icon="pack://application:,,,/ReimBox;component/logo/icon.png"
        Height="790"
        Width="1360"
        MinHeight="660"
        MinWidth="1120"
        Background="#F6F8FC"
        FontFamily="Microsoft YaHei UI"
        AllowDrop="True"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5EAF2" />
        <SolidColorBrush x:Key="SoftPrimaryBrush" Color="#EFF6FF" />
        <converters:AttachmentThumbnailConverter x:Key="AttachmentThumbnailConverter" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource StatButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#BFDBFE" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="66" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style TargetType="ComboBox">
            <EventSetter Event="PreviewMouseWheel" Handler="ComboBox_PreviewMouseWheel" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Background="Transparent">
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#64748B"
                                                  Width="8"
                                                  Height="5"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="13,0,34,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Padding="4">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AlternatingRowBackground" Value="#FBFCFE" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="Outer" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="Accent" Width="4" HorizontalAlignment="Left" Background="Transparent" Panel.ZIndex="1" />
                                <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1">
                                    <DataGridCellsPresenter />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#F8FBFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeftAlignedCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- 鼠标悬停 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                Property="Background"
                                Value="#DC2626" />
                                <Setter TargetName="Chrome"
                                Property="BorderBrush"
                                Value="#DC2626" />
                            </Trigger>

                            <!-- 鼠标按下 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                Property="Background"
                                Value="#B91C1C" />
                            </Trigger>

                            <!-- 不可用 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome"
                                Property="Opacity"
                                Value="0.45" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock Text="ReimBox" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="本地处理 · 原始文件只读 · 自动检查材料完整性" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="项目" Click="ProjectMenu_Click" Margin="30,0,15,0" ToolTip="新建、打开或保存 ReimBox 项目" />
                <Button Content="导入文件" Command="{Binding ImportCommand}" Margin="0,0,15,0" ToolTip="导入一个或多个 PDF（Ctrl+O）" />
                <Button Content="导入文件夹" Command="{Binding ImportFolderCommand}" Margin="0,0,15,0" ToolTip="递归扫描文件夹中的 PDF" />
                <Button Content="{Binding ReimbursementInfoButtonText}" Click="EditReimbursementInfo_Click" Margin="0,0,15,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRequiredReimbursementInfo}" Value="True">
                                    <Setter Property="Foreground" Value="#047857" />
                                    <Setter Property="Background" Value="#ECFDF5" />
                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="批量命名" Click="EditNamingRule_Click" Margin="0,0,15,0" />
                <Button Content="设置" Click="Settings_Click" Margin="0,0,15,0" />
                <Button Content="生成报销材料" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,16"
                Padding="22,18"
                BorderThickness="1.5"
                CornerRadius="16"
                AllowDrop="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImportDragOver}" Value="True">
                            <Setter Property="Background" Value="#ECFDF5" />
                            <Setter Property="BorderBrush" Value="#10B981" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ProgressMessage}" Foreground="#1D4ED8" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="📄" FontSize="30" Margin="0,0,16,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#1E3A8A">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="拖入发票或文件夹" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImportDragOver}" Value="True">
                                        <Setter Property="Text" Value="松开鼠标，开始导入材料" />
                                        <Setter Property="Foreground" Value="#047857" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="仅支持导入 PDF 发票；选中发票后可在右侧添加支付凭证、订单页面等附件"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>
            </DockPanel>
                <ProgressBar Grid.Row="1"
                             Value="{Binding OperationProgress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Margin="0,14,0,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource ThinProgressBarStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,8,0">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="快速复核" Click="QuickReview_Click" Margin="0,0,8,0" Padding="12,7" ToolTip="逐张处理待确认发票" />
                                <Button Content="批量编辑" Click="BulkEdit_Click" Margin="0,0,8,0" Padding="12,7" ToolTip="可先按 Ctrl 或 Shift 多选发票" />
                                <Button Content="{Binding UndoDeleteText}" Command="{Binding UndoDeleteCommand}" Margin="0,0,8,0" Padding="12,7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUndoDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="删除选中" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButtonStyle}" Padding="12,7" />
                            </StackPanel>
                            <TextBlock Text="发票列表" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </DockPanel>
                        <WrapPanel Margin="0,13,0,0">
                            <Button Style="{StaticResource FilterButtonStyle}" Tag="{Binding IsAllFilterActive}" Command="{Binding ShowAllCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="全部 " /><TextBlock Text="{Binding Records.Count}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FilterButtonStyle}" Tag="{Binding IsConsumableFilterActive}" Command="{Binding ShowConsumableCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="耗材 " /><TextBlock Text="{Binding ConsumableCount}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FilterButtonStyle}" Tag="{Binding IsTravelFilterActive}" Command="{Binding ShowTravelCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="差旅 " /><TextBlock Text="{Binding TravelCount}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FilterButtonStyle}" Tag="{Binding IsPrintFeeFilterActive}" Command="{Binding ShowPrintFeeCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="打印费 " /><TextBlock Text="{Binding PrintFeeCount}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FilterButtonStyle}" Tag="{Binding IsOtherFilterActive}" Command="{Binding ShowOtherCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="其他 " /><TextBlock Text="{Binding OtherCount}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FilterButtonStyle}" Tag="{Binding IsPendingFilterActive}" Command="{Binding ShowPendingCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="待处理 " /><TextBlock Text="{Binding PendingCount}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource FilterButtonStyle}" Tag="{Binding IsDuplicateFilterActive}" Command="{Binding ShowDuplicateCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="疑似重复 " /><TextBlock Text="{Binding DuplicateCount}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                        </WrapPanel>
                        <Grid Margin="0,12,0,0" Height="40">
                            <TextBox x:Name="InvoiceSearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="36,0,84,0"
                                     AutomationProperties.Name="搜索发票"
                                     ToolTip="可搜索文件名、商品、商户、分类、发票号码或金额" />
                            <TextBlock Text="⌕" FontSize="20" Foreground="#94A3B8" Margin="13,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock Text="搜索文件名、项目、商户或金额"
                                       Foreground="#94A3B8"
                                       Margin="38,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="清除" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" Padding="10,4" MinHeight="30" Margin="0,5,5,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Background="White">
                        <Grid>
                        <DataGrid ItemsSource="{Binding RecordsView}"
                                  x:Name="InvoiceGrid"
                                  SelectedItem="{Binding SelectedRecord}"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  AutoGenerateColumns="False"
                                  KeyDown="InvoiceGrid_KeyDown">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" Width="54" ElementStyle="{StaticResource LeftAlignedCellTextStyle}" />
                                <DataGridTextColumn Header="文件" Binding="{Binding OriginalFileName}" Width="120" ElementStyle="{StaticResource LeftAlignedCellTextStyle}" />
                                <DataGridTextColumn Header="项目 / 商户" Binding="{Binding ProjectMerchantDisplay}" Width="*" ElementStyle="{StaticResource LeftAlignedCellTextStyle}" />
                                <DataGridTextColumn Header="分类" Binding="{Binding CategoryDisplay}" Width="92" ElementStyle="{StaticResource LeftAlignedCellTextStyle}" />
                                <DataGridTextColumn Header="金额" Binding="{Binding TotalAmount, StringFormat=¥{0:N2}}" Width="104" ElementStyle="{StaticResource LeftAlignedCellTextStyle}" />
                                <DataGridTemplateColumn Header="材料状态" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding MaterialStatusBackground}" CornerRadius="9" Padding="9,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding MaterialStatusLabel}" Foreground="{Binding MaterialStatusForeground}" FontWeight="SemiBold" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVisibleRecords}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="54" Height="54" CornerRadius="27" Background="#EFF6FF" Margin="0,0,0,12">
                                    <TextBlock Text="📄" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding EmptyStateMessage}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" LineHeight="24" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False" />

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="11" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="发票详情" Command="{Binding ShowDetailCommand}" Style="{StaticResource PanelTabButtonStyle}" Tag="{Binding IsDetailMode}" Margin="0,0,4,0" />
                                <Button Content="PDF预览" Command="{Binding ShowPreviewCommand}" Style="{StaticResource PanelTabButtonStyle}" Tag="{Binding IsPreviewMode}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel DataContext="{Binding SelectedRecord}">
                            <TextBlock Text="发票详情" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <WrapPanel Margin="0,14,0,12">
                                <Border Background="#EFF6FF" CornerRadius="10" Padding="12,7" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding TotalAmount, StringFormat=¥{0:N2}}" Foreground="#1D4ED8" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="10" Padding="12,7" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding CategoryDisplay}" Foreground="#334155" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="{Binding MaterialStatusBackground}" CornerRadius="10" Padding="12,7" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding MaterialStatusLabel}" Foreground="{Binding MaterialStatusForeground}" FontWeight="SemiBold" />
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="基本信息" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding OriginalFileName}" FontWeight="SemiBold" Foreground="#334155" />
                                    <TextBlock Text="{Binding OriginalFilePath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10" />
                                    <TextBlock Text="{Binding SellerName, StringFormat=销售方：{0}}" />
                                    <TextBlock Text="{Binding InvoiceDate, StringFormat=开票日期：{0:yyyy-MM-dd}}" />
                                    <TextBlock Text="{Binding InvoiceNumber, StringFormat=发票号码：{0}}" />
                                    <TextBlock Text="{Binding DuplicateHint}" Foreground="#BE185D" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPossibleDuplicate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="确认不是重复发票"
                                            Command="{Binding DataContext.DismissDuplicateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5" MinHeight="32">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPossibleDuplicate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                    <TextBlock Text="{Binding MissingFilesDisplay}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMissingFiles}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="分类" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" />
                                    <TextBlock Text="一级分类" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedValue="{Binding Category}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                                    <TextBlock Text="二级分类" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5" />
                                    <ComboBox ItemsSource="{Binding SubCategoryOptions}" SelectedValue="{Binding SubCategory}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="识别结果" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding RecognitionMethodDisplay, StringFormat=识别方式：{0}}" />
                                    <TextBlock Text="{Binding Confidence, StringFormat=字段完整度：{0:P0}}" />
                                    <TextBlock Text="金额（可手动修正）" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,5" />
                                    <TextBox Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="商品 / 说明" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5" />
                                    <TextBox Text="{Binding ItemDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBoxStyle}" ToolTip="{Binding ItemDescription}" />

                                    <TextBlock Text="字段校验" FontWeight="SemiBold" Foreground="#334155" Margin="0,16,0,5" />
                                    <ItemsControl ItemsSource="{Binding ValidationDisplays}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="补充材料" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding RequirementDisplays}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Margin="0,3" Foreground="#334155" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Margin="0,14,0,0"
                                            Padding="18"
                                            BorderThickness="1.5"
                                            CornerRadius="12"
                                            AllowDrop="True"
                                            Cursor="Hand"
                                            ToolTip="点击选择附件，或直接拖入附件"
                                            MouseLeftButtonUp="Attachment_Click"
                                            DragOver="Attachment_DragOver"
                                            DragLeave="Attachment_DragLeave"
                                            Drop="Attachment_Drop">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFBEB" />
                                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsAttachmentDragOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="点击选择附件，或将支付凭证、订单页面拖到这里" />
                                                    <Setter Property="Foreground" Value="#92400E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsAttachmentDragOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Text" Value="松开鼠标，将附件关联到当前发票" />
                                                            <Setter Property="Foreground" Value="#047857" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="已关联附件" FontWeight="SemiBold" Foreground="#334155" Margin="0,16,0,5" />
                                    <ItemsControl ItemsSource="{Binding SupplementAttachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,4,0,0" Background="#F8FAFC">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="126" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <Border Width="42" Height="42" CornerRadius="8" Background="#E2E8F0" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Image Source="{Binding FilePath, Converter={StaticResource AttachmentThumbnailConverter}}" Stretch="UniformToFill">
                                                                        <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                                                    </Image>
                                                                    <TextBlock Text="📎" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" Foreground="#334155" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding AttachmentTypeDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                                                            <TextBlock Text="文件已丢失" Foreground="#B91C1C" FontSize="12" Margin="0,3,0,0">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FileExists}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding AttachmentTypeOptions}"
                                                                  SelectedValue="{Binding AttachmentType}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="Label"
                                                                  IsEnabled="{Binding IsSupplement}"
                                                                  SelectionChanged="AttachmentType_SelectionChanged"
                                                                  Margin="8,0,0,0" />
                                                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="8,0,0,0">
                                                            <Button Content="上移" Click="AttachmentMoveUp_Click" Padding="9,4" MinHeight="30" Margin="0,0,0,4" />
                                                            <Button Content="下移" Click="AttachmentMoveDown_Click" Padding="9,4" MinHeight="30" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Vertical" Margin="8,0,0,0">
                                                            <Button Content="预览" Click="AttachmentPreview_Click" Padding="10,4" MinHeight="30" Margin="0,0,0,4" />
                                                            <Button Content="删除" Click="AttachmentDelete_Click" IsEnabled="{Binding IsSupplement}" Padding="10,4" MinHeight="30" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="快速重新分析" Command="{Binding DataContext.AnalyzeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Padding="12,7" />
                                <Button Content="Paddle 深度识别" Command="{Binding DataContext.PaddleAnalyzeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Padding="12,7" />
                                <Button Content="重新检查材料" Command="{Binding DataContext.RecheckCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Padding="12,7" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" DataContext="{Binding SelectedRecord}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsPreviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding DataContext.PdfPreviewZoomPercent, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=缩放 {0}}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DataContext.PdfPreviewPageDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding DataContext.PdfPreviewStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Background="#F8FAFC" Padding="14">
                            <Grid>
                                <ScrollViewer x:Name="PdfPreviewScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="PdfPreview_PreviewMouseWheel"
                                              PreviewMouseLeftButtonDown="PdfPreview_MouseLeftButtonDown"
                                              PreviewMouseLeftButtonUp="PdfPreview_MouseLeftButtonUp"
                                              PreviewMouseMove="PdfPreview_MouseMove"
                                              MouseLeave="PdfPreview_MouseLeave"
                                              Cursor="Hand">
                                    <Image Source="{Binding DataContext.PdfPreviewImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Stretch="Uniform"
                                           MaxWidth="{Binding ActualWidth, ElementName=PdfPreviewScrollViewer}"
                                           MaxHeight="{Binding ActualHeight, ElementName=PdfPreviewScrollViewer}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                        <Image.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding DataContext.PdfPreviewZoom, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ScaleY="{Binding DataContext.PdfPreviewZoom, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Image.LayoutTransform>
                                    </Image>
                                </ScrollViewer>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.PdfPreviewImage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="64" Height="64" CornerRadius="32" Background="#EFF6FF" Margin="0,0,0,12">
                                        <TextBlock Text="📄" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="正在准备 PDF 预览" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextAlignment="Center" />
                                    <TextBlock Text="{Binding DataContext.PdfPreviewStatus, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="上一页" Command="{Binding DataContext.PreviousPdfPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,8" />
                            <Button Content="下一页" Command="{Binding DataContext.NextPdfPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,8" />
                            <Button Content="适应窗口" Command="{Binding DataContext.ResetPdfPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,8" />
                            <Button Content="打开 PDF" Command="{Binding DataContext.OpenSelectedFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8" />
                            <Button Content="在文件夹中定位" Command="{Binding DataContext.RevealSelectedFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,9" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountSummary}" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock Text="原始文件保护：开启" Foreground="#166534" FontWeight="SemiBold" Margin="0,0,22,0" />
                <TextBlock Text="{Binding FooterSummary}" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
