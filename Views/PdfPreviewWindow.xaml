<Window x:Class="ReimbursementAssistant.Views.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF 预览"
        Icon="pack://application:,,,/ReimBox;component/logo/icon.png"
        Width="960"
        Height="800"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding PdfPreviewZoomPercent, StringFormat=缩放 {0}}"
                       Foreground="#64748B"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedRecord.OriginalFileName}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="#0F172A"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="500"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding PdfPreviewPageDisplay}"
                           Foreground="#64748B"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding PdfPreviewStatus}"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="16"
                Background="#F8FAFC"
                Padding="14">
            <Grid>
                <ScrollViewer x:Name="PdfPreviewScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="PdfPreview_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="PdfPreview_MouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="PdfPreview_MouseLeftButtonUp"
                              PreviewMouseMove="PdfPreview_MouseMove"
                              MouseLeave="PdfPreview_MouseLeave"
                              Cursor="Hand">
                    <Image Source="{Binding PdfPreviewImage}"
                           Stretch="Uniform"
                           MaxWidth="{Binding ActualWidth, ElementName=PdfPreviewScrollViewer}"
                           MaxHeight="{Binding ActualHeight, ElementName=PdfPreviewScrollViewer}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding PdfPreviewZoom}"
                                            ScaleY="{Binding PdfPreviewZoom}" />
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PdfPreviewImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="64" Height="64" CornerRadius="32" Background="#EFF6FF" Margin="0,0,0,12">
                        <TextBlock Text="📄" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="正在准备 PDF 预览"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding PdfPreviewStatus}"
                               Foreground="#64748B"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="上一页" Command="{Binding PreviousPdfPageCommand}" Margin="0,0,10,8" />
            <Button Content="下一页" Command="{Binding NextPdfPageCommand}" Margin="0,0,10,8" />
            <Button Content="适应窗口" Command="{Binding ResetPdfPreviewCommand}" Margin="0,0,10,8" />
            <Button Content="打开 PDF" Command="{Binding OpenSelectedFileCommand}" Margin="0,0,10,8" />
            <Button Content="在文件夹中定位" Command="{Binding RevealSelectedFileCommand}" Margin="0,0,0,8" />
        </WrapPanel>
    </Grid>
</Window>
