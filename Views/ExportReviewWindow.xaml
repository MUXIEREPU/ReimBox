<Window x:Class="ReimbursementAssistant.Views.ExportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出前检查"
        Icon="pack://application:,,,/ReimBox;component/logo/icon.png"
        Width="680"
        Height="520"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="22" Padding="24" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="报销材料检查" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="导出前请确认材料状态，异常项会在下面列出。" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" />
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Background="#EFF6FF" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="总笔数" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="TotalCountText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Background="#ECFDF5" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="完整" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="CompleteCountText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Background="#FFFBEB" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="待处理" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="PendingCountText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Background="#F8FAFC" CornerRadius="12" Padding="14">
                    <StackPanel><TextBlock Text="总金额" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="TotalAmountText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="14" Background="#F8FAFC">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="需要注意的材料" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,10" />
                    <ListBox x:Name="IssueList" Grid.Row="1" BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock x:Name="HintText" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="返回修改" Click="Return_Click" Margin="0,0,10,0" Background="White" BorderBrush="#CBD5E1" Foreground="#334155" />
                    <Button x:Name="ContinueButton" Content="仍然导出" Click="Continue_Click" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
