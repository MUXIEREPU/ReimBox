<Window x:Class="ReimbursementAssistant.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReimBox 新版本" Icon="pack://application:,,,/ReimBox;component/logo/icon.png"
        Width="610" Height="500" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#F6F8FC" FontFamily="Microsoft YaHei UI">
    <Border Margin="22" Padding="26" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <Border Background="#ECFDF5" CornerRadius="10" Padding="10,5" HorizontalAlignment="Left"><TextBlock Text="发现新版本" Foreground="#047857" FontWeight="SemiBold"/></Border>
                <TextBlock x:Name="VersionText" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,5"/>
                <TextBlock x:Name="CurrentVersionText" Foreground="#64748B"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,18,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="23"/></ScrollViewer>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <CheckBox x:Name="IgnoreCheck" Content="本版本不再提醒" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="稍后再说" Click="Later_Click" Padding="18,10" Margin="10,0"/><Button Content="打开下载页面" Click="Download_Click" Padding="18,10" Background="#2563EB" Foreground="White"/></StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
