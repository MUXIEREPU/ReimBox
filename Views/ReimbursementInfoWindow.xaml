<Window x:Class="ReimbursementAssistant.Views.ReimbursementInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加说明"
        Icon="/logo/icon.png"
        Width="526"
        Height="600"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F6F8FC"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Padding="26" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="添加报销说明" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="这些内容会在导出报销材料时写入主文件夹中的 README.txt。" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,20" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="报销人姓名 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
                    <TextBox x:Name="NameBox" />

                    <TextBlock Text="学号/工号 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,14,0,6" />
                    <TextBox x:Name="IdentifierBox" />

                    <TextBlock Text="补充说明（可选）" FontWeight="SemiBold" Foreground="#334155" Margin="0,14,0,6" />
                    <Grid>
                        <TextBox x:Name="DescriptionBox"
                                 Height="140"
                                 Padding="14,10"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="DescriptionBox_TextChanged" />
                        <TextBlock x:Name="DescriptionPlaceholder"
                                   Text="例如：本次报销用途、项目名称、发票特殊情况、附件说明等。"
                                   Foreground="#94A3B8"
                                   Margin="14,9,14,0"
                                   IsHitTestVisible="False"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="* 为必填项" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Click="Cancel_Click" Margin="10,0,10,0" Background="White" BorderBrush="#CBD5E1" Foreground="#334155" />
                    <Button Content="保存说明" Click="Save_Click" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" Foreground="White" RenderTransformOrigin="1.743,0.839" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
