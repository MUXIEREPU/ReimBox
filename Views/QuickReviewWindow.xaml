<Window x:Class="ReimbursementAssistant.Views.QuickReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待确认快速复核" Icon="pack://application:,,,/ReimBox;component/logo/icon.png" Width="720" Height="590" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#F6F8FC" FontFamily="Microsoft YaHei UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="12,0"/></Style>
    </Window.Resources>
    <Border Margin="22" Padding="26" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="10" Padding="12,7"><TextBlock x:Name="ProgressText" Foreground="#1D4ED8" FontWeight="SemiBold"/></Border>
                <StackPanel><TextBlock Text="待确认快速复核" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="选择正确分类后确认，系统会自动进入下一张。" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="18" Padding="22" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock x:Name="FileNameText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PathText" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,18"/>
                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <Border Background="#EFF6FF" CornerRadius="12" Padding="15" Margin="0,0,8,0"><StackPanel><TextBlock Text="金额" Foreground="#64748B"/><TextBlock x:Name="AmountText" FontSize="22" FontWeight="SemiBold" Foreground="#1D4ED8"/></StackPanel></Border>
                        <Border Background="#FFFFFF" CornerRadius="12" Padding="15" Margin="8,0,0,0"><StackPanel><TextBlock Text="项目 / 商户" Foreground="#64748B"/><TextBlock x:Name="MerchantText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                    </UniformGrid>
                    <TextBlock Text="一级分类（快捷键 1～4）" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="CategoryBox_SelectionChanged"/>
                    <TextBlock Text="二级分类" Foreground="#64748B" Margin="0,14,0,6"/>
                    <ComboBox x:Name="SubCategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                    <Border Background="#FFFBEB" CornerRadius="10" Padding="12" Margin="0,18,0,0"><TextBlock x:Name="IssueText" Foreground="#92400E" TextWrapping="Wrap"/></Border>
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Text="Enter：确认并下一张　Esc：关闭" Foreground="#64748B" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="关闭" Click="Close_Click" Margin="0,0,10,0"/>
                    <Button x:Name="ConfirmButton" Content="确认并下一张" Click="Confirm_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
