<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReimBox</AssemblyName>
    <Product>ReimBox</Product>
    <Description>ReimBox local reimbursement material organizer</Description>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <ApplicationIcon>logo\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
    <EmbeddedResource Remove="Tools\**\*" />
    <None Remove="Tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PaddleWorker\paddle_vl_worker.py" LogicalName="ReimBox.PaddleWorker.paddle_vl_worker.py" />
    <Resource Include="logo\icon.png" />
  </ItemGroup>

</Project>
